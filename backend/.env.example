# Configuração da API do Gemini
# Obtenha sua chave no Google AI Studio: https://aistudio.google.com/
# Use GEMINI_API_KEY=mock para rodar com respostas simuladas (sem chave real).
GEMINI_API_KEY=sua_chave_aqui
# Use um modelo válido do Google AI Studio (ex.: gemini-2.5-flash, gemini-2.0-flash).
GEMINI_MODEL=gemini-2.5-flash

# Configuração do Banco de Dados
# Se deixar vazio ou não configurar, o sistema usará automaticamente um banco SQLite local (catalog_audit.db)
# Para Supabase/PostgreSQL, insira a connection string completa:
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Origens permitidas para CORS (separadas por vírgula). Default: Streamlit local.
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Configurações do Scheduler (intervalos em minutos)
# SCHEDULER_SYNC_STOCK_MINUTES=15
# SCHEDULER_SYNC_QUESTIONS_MINUTES=10
# SCHEDULER_REFRESH_TOKENS_MINUTES=30
# SCHEDULER_CHECK_ALERTS_MINUTES=10

# Shopee Integration
# SHOPEE_PARTNER_ID=
# SHOPEE_PARTNER_KEY=

